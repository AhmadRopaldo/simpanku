rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && authEmail() == 'ahmadropaldo@gmail.com';
    }

    function isActiveMember() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        (
          firestore.exists(/databases/ai-studio-24636540-e8d7-4730-aca1-5ad52a700e4e/documents/members/$(authEmail())) &&
          firestore.get(/databases/ai-studio-24636540-e8d7-4730-aca1-5ad52a700e4e/documents/members/$(authEmail())).data.active == true
        )
      );
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        (
          firestore.exists(/databases/ai-studio-24636540-e8d7-4730-aca1-5ad52a700e4e/documents/members/$(authEmail())) &&
          firestore.get(/databases/ai-studio-24636540-e8d7-4730-aca1-5ad52a700e4e/documents/members/$(authEmail())).data.active == true &&
          firestore.get(/databases/ai-studio-24636540-e8d7-4730-aca1-5ad52a700e4e/documents/members/$(authEmail())).data.role == 'admin'
        )
      );
    }

    // Media grup (foto maks 15 MB, video maks 50 MB)
    match /media/{uploaderUid}/{albumId}/{fileName} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && request.auth.uid == uploaderUid
        && request.resource != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 15 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
        );
      allow delete: if isActiveMember() && (isAdmin() || request.auth.uid == uploaderUid);
      allow update: if false;
    }

    // Dokumen PDF grup (maks 25 MB)
    match /documents/{uploaderUid}/{folderId}/{fileName} {
      allow read: if isActiveMember();
      allow create: if isActiveMember()
        && request.auth.uid == uploaderUid
        && request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if isActiveMember() && (isAdmin() || request.auth.uid == uploaderUid);
      allow update: if false;
    }

    // Tolak semua path lain
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
